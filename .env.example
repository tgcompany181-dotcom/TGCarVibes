# Modes: Supabase values set → Supabase. Else ADMIN_PASSWORD set → LOCAL (data in DATA_DIR/db.json on this server).
# Else → DEMO (in-memory dummy data, public demo logins).
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
SESSION_SECRET=
DATA_DIR=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the daily cron job (invoice generation + SMS reminders).
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/daily. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Payment details shown to customers
NEXT_PUBLIC_PAYID=pay@tgcarvibes.com.au
NEXT_PUBLIC_ACCOUNT_NAME=TG Car Vibes Pty Ltd
NEXT_PUBLIC_OWNER_NAME=Tony

# Optional: SMS reminders (1 day before due and when overdue) via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
